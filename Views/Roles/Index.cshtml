@model IEnumerable<Juego.Models.Roles>

@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Roles ggggg</h1>
    <a class="btn btn-primary" asp-action="Create" title="Crear">
        Crear Rol <i class="fa-solid fa-plus"></i>
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.IdRol)</th>
            <th>@Html.DisplayNameFor(model => model.NombreRol)</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdRol</td>
                <td>@item.NombreRol</td>
                <td>
                    <div class="btn-group" role="group">
                        <a class="btn btn-primary"
                           asp-action="Edit"
                           asp-route-id="@item.IdRol"
                           title="Editar">
                            <i class="fa-solid fa-pen"></i>
                        </a>

                        <a class="btn btn-danger"
                           asp-action="Delete"
                           asp-route-id="@item.IdRol"
                           title="Eliminar">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

